python_sources(
  name="roboto-src",
  sources=["*.py", "**/*.py"],
)

resource(
    name="py_typed",
    source="py.typed",
)

# Read by a test in this package and by a Vitest test in web-ui, which compare the filter
# vocabulary across the two hand-maintained schemas. There is no codegen between them.
resource(
    name="filter_comparators",
    source="query/filter_comparators.json",
)

# The platform event catalog (roots, default root, once_per legality) as the web UI's
# TypeScript mirror reads it. Generated by scripts/gen_trigger_manifests.py and
# drift-checked by a test in this package and a Vitest test in web-ui.
resource(
    name="event_catalog",
    source="domain/platform_events/event_catalog.json",
)

# Golden file for the sample events (what a trigger's templates can reference,
# with realistic values). Generated by scripts/gen_trigger_manifests.py and checked
# in so a change to any hydrated record model shows up as a reviewable diff here; a
# test fails when the two disagree.
resource(
    name="event_samples",
    source="domain/triggers/event_samples.json",
)

# Which kinds of entity each trigger target can act on, as the web UI's target picker
# reads it. Generated by scripts/gen_trigger_manifests.py and drift-checked by a test
# in this package.
resource(
    name="target_catalog",
    source="domain/triggers/target_catalog.json",
)

